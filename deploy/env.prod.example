# 生产环境变量示例 — 复制为 deploy/.env.prod 或在服务器 export
ENVIRONMENT=production
API_AUTH_ENABLED=1
API_AUTH_KEY=change-me-to-a-long-random-secret
CORS_ORIGINS=https://your-public-domain.com
REVIEW_TOKEN_SECRET=change-me-to-a-long-random-secret
RPA_WEBHOOK_SECRET=change-me-to-a-long-random-secret
REVIEW_BASE_URL=https://your-public-domain.com
REVIEW_FEISHU_WEBHOOK_URL=
PUBLISH_QUEUE_ENABLED=1
PUBLISH_QUEUE_INTERVAL_SEC=300
PERCEPTION_SCHEDULE_ENABLED=1
POST_PUBLISH_MONITOR_ENABLED=1
ORG_ISOLATION_ENABLED=1
COMBINED_ROI_ENABLED=1
SLICE_APPROVE_MATRIX_PUBLISH=1
PUBLISH_SMOKE_SUBMIT_ENABLED=0
