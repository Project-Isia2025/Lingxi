# =============================================================================
# 工程师落地版 · LangChain + 低代码 + 平台 API（详见 /dashboard/engineering）
# =============================================================================
# [编排] LangGraph + OrchestratorAgent  → orchestrator/
# [LLM]  OpenAI 兼容 API               → LLM_API_BASE / LLM_API_KEY / LLM_MODEL
# [向量] Qdrant（等价 Milvus/Pinecone）→ QDRANT_HOST / QDRANT_PORT
# [RPA]  Playwright + 影刀 Webhook 回写     → /api/rpa/webhook/yingdao
# [内容] ffmpeg + TTS + VIDEO_PROVIDER      → template | heygen | capcut | volc | kling
# [审批] 飞书 Webhook + 工作流决策     → REVIEW_FEISHU_WEBHOOK_URL
# [部署] Docker Compose                 → docker compose up -d
# =============================================================================

# Lingxi Engine 默认端口 9200（避免与 AI口播智能体 9100 冲突）
API_PORT=9200

# 环境：production 时启动强制检查 REVIEW_TOKEN_SECRET / RPA_WEBHOOK_SECRET
ENVIRONMENT=development
# CORS 白名单（逗号分隔；留空则允许 *，仅建议开发环境）
# CORS_ORIGINS=http://127.0.0.1:9200,http://localhost:9200
# 联调接口门控（/api/rpa/test-ingest 需 DEBUG=1）
DEBUG=0

# LangGraph 实验编排（默认关闭；生产用 orchestrator_agent）
# LANGGRAPH_ORCHESTRATOR_ENABLED=0

# 后台 Worker 多副本 Leader 选举（需 Redis；不可用时降级单节点）
WORKER_LEADER_LOCK_ENABLED=1
WORKER_LEADER_LOCK_TTL_SEC=120
REDIS_HOST=localhost
REDIS_PORT=6379

# SQLite 迁移（Alembic + schema_meta；默认开启）
DB_MIGRATE_ENABLED=1

# Worker 承载方式：celery（默认，需 celery worker + beat）| thread（legacy 线程 + Leader Lock）
# Windows 本机：Memurai 监听 localhost:6379 后启用 celery；无 Redis 时用 thread + WORKER_LEADER_LOCK_ENABLED=0
WORKER_BACKEND=celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# API 鉴权（生产环境务必开启）
API_AUTH_ENABLED=0
# API_AUTH_KEY=至少16位随机字符串，支持逗号分隔多个 key 轮换
# API_AUTH_ADMIN_KEY=可选；配置后 POST /api/orchestrator/run 等 admin 路由需此 key
# API_AUTH_KEY=

# LLM（OpenAI 兼容）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=60
# 多模型轮换（主模型失败时自动尝试备选，防单点封禁）
LLM_ROTATION_ENABLED=1
# LLM_MODELS=deepseek-chat,qwen-max,gpt-4o
# LLM_FALLBACK_MODELS=qwen-max,gpt-4o
# 高级：独立网关配置 JSON（每项含 base/key/model/label）
# LLM_PROFILES_JSON=[{"label":"deepseek","base":"https://api.deepseek.com/v1","key":"sk-...","model":"deepseek-chat"}]

# 抖音爬虫
DOUYIN_CRAWLER_ENABLED=1
DOUYIN_STORAGE_STATE=data/state/douyin_pc_storage.json
# DOUYIN_COOKIE_FILE=data/state/douyin_cookies.txt
DOUYIN_PLAYWRIGHT_HEADLESS=0
DOUYIN_HEADED_ON_CAPTCHA=1
DOUYIN_CAPTCHA_WAIT_SEC=120
DOUYIN_COLLECT_WAIT_SEC=90
# DOUYIN_PLAYWRIGHT_CHANNEL=chrome

# 小红书爬虫
XHS_CRAWLER_ENABLED=1
XHS_STORAGE_STATE=data/state/xhs_pc_storage.json
# XHS_COOKIE_FILE=data/state/xhs_cookies.txt
XHS_PLAYWRIGHT_HEADLESS=0
XHS_HEADED_ON_CAPTCHA=1
XHS_CAPTCHA_WAIT_SEC=120
XHS_COLLECT_WAIT_SEC=90

# ffmpeg 混剪
VIDEO_MIX_ENABLED=1
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
VIDEO_OUTPUT_DIR=data/output/videos

# 投流 API（巨量引擎 OpenAPI）
# AD_API_BASE=https://ad.oceanengine.com
# AD_API_KEY=
# OCEANENGINE_ADVERTISER_ID=
# AD_API_TIMEOUT_SEC=30

# TTS 配音（混剪口播）
TTS_ENABLED=1
TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_API_BASE=  # OpenAI 兼容 /audio/speech 可选
# TTS_API_KEY=

# 小红书正文深度抓取
XHS_ENRICH_DETAIL=1
XHS_ENRICH_LIMIT=3
XHS_OCR_ENABLED=1
XHS_OCR_IMAGE_LIMIT=3

# OCR（笔记图片文字）
OCR_ENABLED=1
OCR_LANG=chi_sim+eng
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# VISION_API_BASE=  # LLM Vision 可选

# 投流报表定时轮询
AD_POLL_ENABLED=0
AD_POLL_INTERVAL_SEC=3600

# 投流自动调价
AD_AUTO_BID_ENABLED=1
AD_BID_RULES_PATH=data/ad_bid_rules.json
AD_BID_CTR_GOOD=0.02
AD_BID_CTR_BAD=0.008
AD_BID_CPC_MAX=8
AD_BID_ROI_SCALE=0.55
AD_BID_ROI_CUT=0.25
AD_BID_BUDGET_UP_PCT=0.15
AD_BID_BUDGET_DOWN_PCT=0.20
AD_BID_MIN_BUDGET=30
AD_BID_MAX_BUDGET=2000

# 内容 OCR 注入 LLM
CONTENT_OCR_INJECT=1

# 视频 ASR 转写（Whisper 兼容 API）
ASR_ENABLED=1
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_TIMEOUT_SEC=120
XHS_ASR_ENABLED=1
ASR_MEMORY_ENABLED=1

# TTS A/B 多音色
TTS_AB_ENABLED=1
TTS_AB_VOICES=zh-CN-XiaoxiaoNeural,zh-CN-YunxiNeural

# 自动发布（Playwright 创作者中心）
DOUYIN_PUBLISH_ENABLED=1
DOUYIN_PUBLISH_STORAGE_STATE=data/state/douyin_creator_storage.json
DOUYIN_PUBLISH_HEADLESS=0
XHS_PUBLISH_ENABLED=1
XHS_PUBLISH_STORAGE_STATE=data/state/xhs_creator_storage.json
XHS_PUBLISH_HEADLESS=0
SHIPINHAO_PUBLISH_ENABLED=0
SHIPINHAO_PUBLISH_STORAGE_STATE=data/state/shipinhao_creator_storage.json
PUBLISH_DAILY_LIMIT=4
PUBLISH_MIN_INTERVAL_SEC=300
PUBLISH_TIMEOUT_SEC=240
PUBLISH_ACCOUNTS_PATH=data/publish_accounts.json
PUBLISH_ACCOUNTS_PER_PLATFORM=2
PUBLISH_RATE_LIMIT_ENABLED=1
MATRIX_RUN_STAGGER_SEC=120
PUBLISH_MAX_QUEUED_PER_RUN=12
PUBLISH_MAX_QUEUED_PER_ACCOUNT=20

# 多租户 org_id 隔离（发布队列/审核 payload）
ORG_ISOLATION_ENABLED=1
# DEFAULT_ORG_ID=
# 多 org Webhook: 复制 data/org_webhooks.example.json → data/org_webhooks.json
# ORG_WEBHOOKS_PATH=data/org_webhooks.json

# 发布队列后台 Worker（定时消费 publish_queue）
# Celery 模式建议 PUBLISH_QUEUE_ENABLED=1；thread 模式由 API 进程内线程消费
PUBLISH_QUEUE_ENABLED=1
PUBLISH_QUEUE_INTERVAL_SEC=300
PUBLISH_QUEUE_BATCH_SIZE=5
PUBLISH_QUEUE_RETRY_ENABLED=1
PUBLISH_QUEUE_MAX_RETRIES=3
PUBLISH_QUEUE_RETRY_DELAY_SEC=600

# 发布成功 ROI 回写
PUBLISH_ROI_ENABLED=1

# 联合 ROI（发布 + 投流）
COMBINED_ROI_ENABLED=1
COMBINED_ROI_PUBLISH_WEIGHT=0.4
COMBINED_ROI_AD_WEIGHT=0.6
PUBLISH_QUEUE_RUN_PRIORITY=5
PUBLISH_DYNAMIC_PRIORITY=1
PUBLISH_ROI_AUTO_REFRESH=1
PUBLISH_PRIORITY_HIGH=15
PUBLISH_PRIORITY_MID=10
PUBLISH_PRIORITY_LOW=5
PUBLISH_PRIORITY_MIN=2

# 联合 ROI 驱动投流调价
COMBINED_ROI_BID_ENABLED=1
COMBINED_ROI_BID_SCALE=0.72
COMBINED_ROI_BID_CUT=0.38
COMBINED_ROI_BID_UP_PCT=0.12
COMBINED_ROI_BID_DOWN_PCT=0.18

# 联合 ROI 矩阵发布策略
MATRIX_ROI_STRATEGY_ENABLED=1
MATRIX_ROI_SKIP_BELOW=0.3
MATRIX_ROI_A_ACCOUNTS=2

# ROI 报表导出
ROI_EXPORT_ENABLED=1

# ROI 定时报表（邮件/本地保存）
ROI_REPORT_SCHEDULE_ENABLED=0
ROI_REPORT_INTERVAL_SEC=86400
ROI_REPORT_DAYS=30
ROI_REPORT_EMAIL_ENABLED=0
ROI_REPORT_EMAIL_TO=ops@example.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=1

# ROI Webhook 告警
ROI_ALERT_ENABLED=1
ROI_ALERT_WEBHOOK_URL=
ROI_ALERT_COMBINED_HIGH=0.75
ROI_ALERT_COMBINED_LOW=0.35
ROI_ALERT_PUBLISH_LOW=0.4
ROI_ALERT_AD_LOW=0.35
ROI_ALERT_DEDUP_ENABLED=1
ROI_ALERT_DEDUP_SEC=3600
# auto | feishu | wecom | generic
ROI_ALERT_WEBHOOK_PROVIDER=auto
# 告警去重日志清理（默认开启，保留 7 天）
ROI_ALERT_CLEANUP_ENABLED=1
ROI_ALERT_CLEANUP_INTERVAL_SEC=86400
ROI_ALERT_CLEANUP_RETENTION_SEC=604800

# 数据感知定时扫描（P0：每 30 分钟热榜+竞品）
PERCEPTION_SCHEDULE_ENABLED=0
PERCEPTION_INTERVAL_SEC=1800
PERCEPTION_MIN_LIKE_RATE=0.05
PERCEPTION_INCLUDE_HOTLIST=1
PERCEPTION_INSIGHTS_ENABLED=1
PERCEPTION_KEYWORDS=
# 库存数据：data/inventory.json

# 成片审核队列 + 飞书卡片
REVIEW_QUEUE_ENABLED=1
REVIEW_FEISHU_WEBHOOK_URL=
REVIEW_FEISHU_USE_CALLBACK=1
REVIEW_FEISHU_BATCH_CARD=1
REVIEW_BASE_URL=http://127.0.0.1:9200
# Runbook 失败告警（飞书/企微 Webhook，可按 org 配置 runbook_webhook_url）
RUNBOOK_ALERT_ENABLED=1
RUNBOOK_ALERT_MIN_FAILURES=1
# 飞书回调 URL 需公网可达: {REVIEW_BASE_URL}/api/review/callback
# 本地开发隧道: python scripts/tunnel_up.py --check
# 启动 ngrok:     python scripts/tunnel_up.py --provider ngrok --port 9200
# Cloudflare:     python scripts/tunnel_up.py --provider cloudflare --port 9200
# Docker 完整栈:  python scripts/docker_up.py --stack full --build
# 上传页 smoke:   python scripts/acceptance_publish_smoke.py --live-probe --headed
# 真实发布:       python scripts/acceptance_publish_smoke.py --submit --confirm --headed --platform douyin
# 生产 Docker:    python scripts/deploy_up.py --stack prod-full --build
# K8s:            kubectl apply -f deploy/k8s/
PUBLISH_SMOKE_SUBMIT_ENABLED=0
REVIEW_TOKEN_SECRET=change-me-in-production
# 飞书机器人请求地址配置：POST /api/review/callback

# 抖音竞品详情补 views（点赞率严格过滤）
DOUYIN_ENRICH_DETAIL=1
DOUYIN_ENRICH_LIMIT=5
PERCEPTION_REQUIRE_REAL_VIEWS=1

# BGM / 视觉去重 / AI 成片
BGM_ENABLED=1
BGM_VOLUME=0.12
VISUAL_DEDUP_ENABLED=1
VISUAL_DEDUP_SPEED_MIN=0.97
VISUAL_DEDUP_SPEED_MAX=1.03
VIDEO_GEN_ENABLED=1
VOLC_API_KEY=
VOLC_API_URL=
VOLC_MODEL=video-gen
VOLC_DURATION_SEC=15
KLING_API_KEY=
KLING_API_URL=
KLING_MODEL=kling-v1
KLING_DURATION_SEC=15
AVATAR_API_KEY=
AVATAR_API_URL=
AVATAR_CLONE_ID=
AVATAR_VOICE_ID=
AVATAR_STYLE=talking_head
AVATAR_DURATION_SEC=15
# HeyGen 数字人 API（https://docs.heygen.com）
HEYGEN_API_KEY=
# HEYGEN_API_URL=https://api.heygen.com/v2/video/generate
HEYGEN_API_BASE=https://api.heygen.com
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_DURATION_SEC=15
HEYGEN_TEST_MODE=0
# 剪映 / CapCut 开放平台
CAPCUT_API_KEY=
CAPCUT_API_URL=
CAPCUT_TEMPLATE_ID=
CAPCUT_DURATION_SEC=15
# CAPCUT_AUTH_HEADER=Bearer
# 别名（与 CAPCUT_* 二选一）
# JIANYING_API_KEY=
# JIANYING_API_URL=
# JIANYING_TEMPLATE_ID=
# 影刀 / 八爪鱼 RPA Webhook 回写感知层
RPA_INGEST_ENABLED=1
RPA_WEBHOOK_SECRET=
# YINGDAO_WEBHOOK_SECRET=
# RPA_INGEST_PATH=data/state/rpa_ingest.json
# RPA_INGEST_MAX_AGE_HOURS=72
# 字段映射：复制 data/rpa_field_mapping.example.json → data/rpa_field_mapping.json
# RPA_FIELD_MAPPING_PATH=data/rpa_field_mapping.json
# 联调: python scripts/acceptance_video_live.py
# 真实 API: python scripts/acceptance_video_live.py --live --confirm --provider avatar

# 发布后完播监控 / 下架 / 重剪
POST_PUBLISH_MONITOR_ENABLED=1
POST_PUBLISH_MONITOR_INTERVAL_SEC=1800
POST_PUBLISH_MONITOR_DELAY_HOURS=24

# 历史任务清理（点头/打回后自动移除；定时 purge 过期记录）
REVIEW_AUTO_DELETE_ON_RESOLVE=1

# SQLite 主库（发布/审核/投流/指标）— 备份此文件
# data/matrix_agent.db
# Postgres 为可选组件（Phase0 记忆 / Campaign API），见 docker compose profile infra

# 历史任务独立清理（Celery Beat）
TASK_CLEANUP_ENABLED=1
TASK_CLEANUP_INTERVAL_SEC=86400

# 生产安全（production 时生效）
# DOCS_PUBLIC_IN_PRODUCTION=0
# API_AUTH_ALLOW_QUERY_KEY=0
# RPA_WEBHOOK_ALLOW_OPEN=0
REVIEW_RETENTION_SEC=604800
WORKFLOW_RUN_RETENTION_SEC=2592000
WORKFLOW_DECISION_RETENTION_SEC=604800
COMPLETION_RATE_MIN=0.30
CTR_MIN=0.008
TAKEDOWN_ENABLED=0
# 创作者中心完播/CTR 回采（需 DOUYIN/XHS_PUBLISH_STORAGE_STATE）
CREATOR_METRICS_ENABLED=1
CREATOR_METRICS_WAIT_MS=6000
TAKEDOWN_WAIT_MS=5000
# 监控 E2E: python scripts/acceptance_monitor_e2e.py
# 生产联调 Runbook: python scripts/acceptance_live_runbook.py
# 运维 Dashboard: http://127.0.0.1:9200/dashboard/runtime
# WebSocket 运维推送: ws://127.0.0.1:9200/ws/dashboard/runtime?org_id=...
# Windows 自启: powershell -ExecutionPolicy Bypass -File scripts/windows/install_service.ps1
# Linux systemd: sudo bash scripts/systemd_install.sh
# Helm 部署: helm upgrade --install ai-agent-matrix ./deploy/helm/ai-agent-matrix

# 3×15s 独立切片初稿 + 商品图合成
SLICE_DRAFTS_ENABLED=1
SLICE_DURATION_SEC=15
SLICE_SCRIPT_MAX_CHARS=120
SLICE_APPROVE_MATRIX_PUBLISH=1
SLICE_APPROVE_MONITOR=1
PRODUCT_COMPOSE_ENABLED=1
# PRODUCT_IMAGE_PATH=data/product_images/default.png
# PRODUCT_IMAGE_SCALE=0.28

# 内容
CONTENT_STYLE=爆款口播
CONTENT_MAX_CHARS=300

# 策略/成片成本
VIDEO_BUDGET_LIMIT=5.0
VIDEO_PROVIDER=template
VIDEO_FALLBACK_PROVIDER=template
