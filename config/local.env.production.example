# =============================================================================
# 灵犀引擎 · 生产环境配置模板
# =============================================================================
# 用法:
#   copy config\local.env.production.example config\local.env
#   填写下方带 CHANGE_ME 的项，然后重启 api_server + celery worker/beat
# =============================================================================

API_PORT=9200
ENVIRONMENT=production

# --- 必填：安全密钥（至少 16 位随机字符串）---
API_AUTH_ENABLED=1
API_AUTH_KEY=CHANGE_ME_api_key_min_16_chars
# API_AUTH_ADMIN_KEY=CHANGE_ME_optional_admin_key
REVIEW_TOKEN_SECRET=CHANGE_ME_review_hmac_secret
RPA_WEBHOOK_SECRET=CHANGE_ME_rpa_webhook_secret

# --- CORS（禁止 *，填实际域名）---
CORS_ORIGINS=https://your-domain.com

# --- 生产安全开关（默认已加固，一般无需改）---
DOCS_PUBLIC_IN_PRODUCTION=0
API_AUTH_ALLOW_QUERY_KEY=0
RPA_WEBHOOK_ALLOW_OPEN=0

# --- Worker（生产推荐 Celery + Redis）---
WORKER_BACKEND=celery
WORKER_LEADER_LOCK_ENABLED=0
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- SQLite 主库（务必备份 data/matrix_agent.db）---
DB_MIGRATE_ENABLED=1

# --- 业务 Worker 开关 ---
PUBLISH_QUEUE_ENABLED=1
POST_PUBLISH_MONITOR_ENABLED=1
ROI_ALERT_CLEANUP_ENABLED=1
TASK_CLEANUP_ENABLED=1
TASK_CLEANUP_INTERVAL_SEC=86400

# --- LLM（必填，否则编排/生成不可用）---
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=deepseek-chat

# --- 对外 URL（审核链接、回调）---
REVIEW_BASE_URL=https://your-domain.com

# --- 可选：飞书 / ROI 告警 ---
# REVIEW_FEISHU_WEBHOOK_URL=
# ROI_ALERT_WEBHOOK_URL=

# --- 日志与调试 ---
DEBUG=0

# 完整可选项见 config/local.env.example
